# === Application ===
APP_ENV=development
APP_NAME=AI Office Lease
APP_TIMEZONE=Asia/Shanghai
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Database ===
DATABASE_URL=postgresql://app:change_me@localhost:5432/office_lease

# === Security ===
SESSION_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_SECRET_KEY=replace_with_another_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# === File Storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/private-storage
MAX_UPLOAD_MB=20
MAX_IMPORT_ROWS=100000
MAX_IMPORT_COLUMNS=200
MAX_IMPORT_SHEETS=50
MAX_CELLS_PER_IMPORT=20000000
PARSE_TIMEOUT_SECONDS=60

# === AI / LLM ===
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# === Export ===
EXPORT_TTL_HOURS=24

# === Logging ===
LOG_LEVEL=INFO

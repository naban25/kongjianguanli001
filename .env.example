# === Application ===
APP_ENV=development
APP_NAME=AI Office Lease
APP_TIMEZONE=Asia/Shanghai
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Database ===
DATABASE_URL=postgresql://app:change_me@localhost:5432/office_lease

# === Security ===
SESSION_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_SECRET_KEY=replace_with_another_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# === File Storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/private-storage
MAX_UPLOAD_MB=20
MAX_IMPORT_ROWS=100000
MAX_IMPORT_COLUMNS=200
MAX_IMPORT_SHEETS=50
MAX_CELLS_PER_IMPORT=20000000
PARSE_TIMEOUT_SECONDS=60

# === AI / LLM ===
# LLM_PROVIDER 必填！ 不设置会让 llm_configured 始终返回 False（流式 API 也会直接降级）
# 常用值: "nvidia"（NVIDIA integrate API） / "openai" / "anthropic" / 自定义 openai 兼容网关名
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=300   # 配合 gunicorn --timeout 310 使用

# === Export ===
EXPORT_TTL_HOURS=24

# === Logging ===
LOG_LEVEL=INFO
